# Copy to .env.local and fill in. .env.local is gitignored.

# Signs the session cookie. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# The single shared password that unlocks /dashboard.
DASHBOARD_PASSWORD=

# Optional. Set this to print the password on the login page, for a portfolio or demo
# deployment where anyone with the link is meant to get in.
#
# It is a SECOND variable on purpose — the login page never prints DASHBOARD_PASSWORD
# itself, so a real deployment cannot publish its password by accident. Leave it unset
# and nothing is shown. Setting it makes the gate decorative; do not set it anywhere the
# dashboard is protecting something.
DEMO_PASSWORD_HINT=
